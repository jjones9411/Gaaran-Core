# Skopiuj ten plik do .env i uzupełnij prawdziwymi wartościami.
# .env NIGDY nie powinien trafić do repozytorium (jest w .gitignore).

# --- Baza danych MySQL ---
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- Adres frontendu (używany w linkach aktywacyjnych/reset hasła w mailach, CORS
# oraz jako publiczny URL gry w feedzie /api/public/feed dla portali zewnętrznych) ---
FRONTEND_URL=http://localhost:5173

# --- Publiczny feed dla portali (/api/public/feed - JSON, /api/public/feed/rss - RSS) ---
# Opcjonalne. Jeśli puste, opis = nazwa gry, a tagi mają domyślną wartość.
# GAME_DESCRIPTION=Krótki opis Twojej gry widoczny w portalu
# GAME_TAGS=mmorpg,postapo,tekstówka

# --- JWT ---
# Długi, losowy sekret (np. `openssl rand -hex 64`). Zmiana unieważni wszystkie
# aktywne tokeny/sesje.
JWT_SECRET=change_me_to_a_long_random_secret

# --- SMTP (nodemailer - aktywacja, reset hasła, mass email z panelu admina) ---
# Można użyć zwykłego SMTP albo SMTP relay Resend (smtp.resend.com, port 465,
# EMAIL_USER=resend, EMAIL_PASS=<Resend API key>).
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Adres widoczny jako nadawca (musi być prawdziwym adresem e-mail, np. z domeny
# zweryfikowanej w Resend). Jeśli puste, używany jest EMAIL_USER.
EMAIL_FROM=noreply@example.com

# --- Liczba hopów reverse proxy przed Node (Express "trust proxy") ---
# Używane m.in. przez rate limiting oparty o IP - źle ustawione albo pozwala
# sfałszować IP (zbyt duża liczba / "ufaj wszystkim"), albo łamie wykrywanie
# prawdziwego IP klienta (zbyt mała liczba).
#   0 = Node wystawiony bezpośrednio, bez reverse proxy
#   1 = jeden reverse proxy przed Node (typowy Nginx/Apache na tym samym VPS) - domyślne
#   2 = Cloudflare (lub inny CDN) + Nginx przed Node
TRUST_PROXY_HOPS=1

# --- Ponowne uruchomienie kreatora instalacyjnego ---
# Kreator (/install) sam się zamyka, gdy widzi ślady działającej gry: marker
# backend/.installed ALBO wypełnioną bazę (game_config.installed_at lub choć
# jedno konto w users). Dzięki temu deploy, który skasuje marker (świeży klon,
# rsync --delete, nowy kontener), nie odsłania kreatora - a ten w pierwszym
# kroku robi DROP DATABASE.
# Ustaw na true TYLKO gdy świadomie chcesz postawić instalację od zera na
# skonfigurowanym już środowisku - to jedyny sposób, żeby kreator znów ruszył
# (nie trzeba kasować markera, wystarczy ta linia + restart procesu).
# Po instalacji skasuj tę linię.
# ALLOW_REINSTALL=true

# --- Pula połączeń do MySQL ---
# connectionLimit musi się mieścić w max_connections serwera bazy (domyślnie 151).
# Zbyt mała pula = wąskie gardło (każde żądanie za autoryzacją to kilka zapytań);
# zbyt duża = wysycenie limitu bazy i błędy "Too many connections".
# DB_CONNECTION_LIMIT=25
# Maksymalna liczba żądań czekających w kolejce na wolne połączenie. Powyżej
# tego zapytanie od razu dostaje błąd zamiast wisieć - to zawór bezpieczeństwa
# przy nagłym zalewie ruchu.
# DB_QUEUE_LIMIT=200

# --- Maksymalny rozmiar ciała żądania JSON ---
# Pliki idą osobno (multipart/multer) i mają własne limity, więc tu wystarczy
# zapas na najdłuższe teksty w grze (opisy postaci, posty sesyjne).
# JSON_BODY_LIMIT=2mb

# --- Rate limiting (ochrona przed zalewem żądań i próbami wyścigów) ---
# Wszystkie wartości są opcjonalne - poniżej wpisane są wartości domyślne.
# Limit globalny: żądań na minutę na ADRES IP (limiter stoi przed autoryzacją,
# więc konta w tym miejscu jeszcze nie znamy - patrz middleware/rateLimiter.js).
# Liczy się cały adres, czyli wszystkie karty wszystkich domowników razem:
# jedna karta grającego to ~45-55 żądań/min (polling HUD-a, karczmy, list).
# Za nisko ustawiona wartość nie "spowalnia" gry, tylko wywala ją 429-tkami.
# RATE_LIMIT_GLOBAL_PER_MINUTE=1200
# Logowanie / reset hasła: prób na 15 minut z jednego IP (udane się nie liczą).
# Chroni przed brute force hasła i przed zagłodzeniem CPU bcryptem.
# RATE_LIMIT_AUTH_PER_15MIN=20
# Rejestracja: kont na godzinę z jednego IP (każda to bcrypt + wysyłka maila).
# RATE_LIMIT_REGISTER_PER_HOUR=5
# Tworzenie postaci: prób na godzinę na konto (limit 4 slotów i tak jest
# egzekwowany transakcyjnie w bazie - to warstwa dodatkowa).
# RATE_LIMIT_CHARACTER_CREATE_PER_HOUR=10
# Upload plików: przesłanych plików na 10 minut na konto.
# RATE_LIMIT_UPLOADS_PER_10MIN=30
